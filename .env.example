# Copy this file to `.env` and fill in real values ONLY if you want the
# crew to call a real hosted LLM provider. Every value below is optional --
# with no keys set, fraud_crew.infrastructure.llm falls back to a
# deterministic offline MockLLM and the whole system (API + crew + tests)
# runs with zero paid API keys.

# --- App ---
APP_ENV=local
LOG_LEVEL=INFO

# --- LLM provider (optional -- leave blank to use the offline MockLLM) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MODEL_NAME=gpt-4o-mini
LLM_REQUEST_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3

# --- Guardrails ---
MAX_COMPLIANCE_ITERATIONS=3

# --- API service ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Observability ---
ENABLE_TRACING_SPANS=true
AUDIT_LOG_PATH=audit_log.jsonl
